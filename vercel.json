{
  "version": 2,
  "name": "onekindact-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://onekindact-api.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://onekindact-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://onekindact-api.vercel.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://onekindact-api.vercel.app/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
